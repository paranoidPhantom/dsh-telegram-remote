{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2024", "DOM"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmitOnError": true,
    "allowJs": false,
    "rootDir": ".",
    "outDir": ".build/unit",
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": [
    "src/client",
    "client.js",
    "node_modules",
    ".build",
    "dist",
    ".cache",
    "test/isolation"
  ]
}
